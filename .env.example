APP_NAME="ITUZE GREEN PLATFORM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=3
# deferred | database (needs php artisan queue:work) | sync
MAIL_QUEUE_CONNECTION=deferred
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RWANDA_VAT_RATE=18
EMAIL_OTP_ENABLED=false

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v22.0

# Mobile money "request to pay" (tenant approves on their phone).
# fake = test mode, no account needed. mtn = MTN MoMo Collections API.
# Sandbox: subscribe to Collections at https://momodeveloper.mtn.com, set the key,
# then run `php artisan momo:sandbox-user` and paste the printed lines here.
MOBILE_MONEY_DRIVER=fake
MOBILE_MONEY_TIMEOUT=180
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=

# SMS alerts for new inquiries: log (default), pindo or africastalking
SMS_DRIVER=log
PINDO_API_TOKEN=
PINDO_SENDER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER=

# Q.R.A bank account shown to owners paying their subscription by transfer
QRA_BANK_NAME="Bank of Kigali PLC (BK)"
QRA_BANK_ACCOUNT_NAME="Q.R.A GROUP LTD"
QRA_BANK_ACCOUNT_NUMBER="100181498484 (RWF)"
